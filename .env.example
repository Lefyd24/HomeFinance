# Personal Finance App Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME=Personal Finance
APP_VERSION=1.0.0

# Security
# IMPORTANT: Change this to a secure random string in production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Database
# Docker (inside container): sqlite:////app/data/finance.db
# Local dev: leave the Docker value OR use sqlite:///../data/finance.db — both resolve to ./data/finance.db
DATABASE_URL=sqlite:////app/data/finance.db

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (for development)
CORS_ORIGINS=["*"]

# Debug Mode (set to true for development)
DEBUG=false

# Ports — Docker Compose, supervisord, backend CORS, and frontend API URL (via runtime-config.js)
BACKEND_PORT=8223
FRONTEND_PORT=3100
# Local static frontend (no Docker): after changing BACKEND_PORT, run from frontend/: npm run sync:runtime-config

# Notifications
NOTIFICATIONS_ENABLED=true
# Generate with: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=

# SMTP (optional — per-user UI settings can override these defaults)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Web Push / VAPID (optional — generate keys with: vapid --gen  or  py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI Chat (DeepSeek) — get an API key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
