# Personal Finance App Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME=Personal Finance
APP_VERSION=1.0.0

# Security
# IMPORTANT: Change this to a secure random string in production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Database
# IMPORTANT: Use an *absolute* path inside the container.
# A relative SQLite URL (sqlite:///data/finance.db) resolves from the backend process CWD
# (in Docker that's typically /app/backend), which would miss the bind mount ./data:/app/data.
DATABASE_URL=sqlite:////app/data/finance.db

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (for development)
CORS_ORIGINS=["*"]

# Debug Mode (set to true for development)
DEBUG=false
