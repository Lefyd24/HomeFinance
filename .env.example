# Personal Finance App Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME=Personal Finance
APP_VERSION=1.0.0

# Security
# Generate with: openssl rand -hex 32
# Required — the app refuses to start with the placeholder default, an empty
# value, or anything shorter than 32 characters (unless DEBUG=true).
SECRET_KEY=

# Database
# Docker (inside container): sqlite:////app/data/finance.db
# Local dev: leave the Docker value OR use sqlite:///../data/finance.db — both resolve to ./data/finance.db
DATABASE_URL=sqlite:////app/data/finance.db

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins
# Leave as [] for same-origin deployments — the backend serves the frontend, which
# is the default and what Tailscale Funnel / any single-port reverse proxy needs.
# Only set explicit origins if the frontend is hosted elsewhere. A wildcard ["*"]
# is downgraded to allow_credentials=False and logged as a warning.
CORS_ORIGINS=[]

# Debug Mode — also bypasses the SECRET_KEY / NOTIFICATION_ENCRYPTION_KEY startup
# validation and re-enables permissive localhost CORS. NEVER set true in production.
DEBUG=false

# Ports — the app is served entirely from BACKEND_PORT (UI at /, API at /api).
BACKEND_PORT=8223
# FRONTEND_PORT is only used by the optional split-port dev workflow
# (python -m http.server 3100); after changing it run: npm run sync:runtime-config
FRONTEND_PORT=3100

# Notifications
NOTIFICATIONS_ENABLED=true
# Generate with: openssl rand -hex 32
# Required whenever NOTIFICATIONS_ENABLED=true. This key (not SECRET_KEY) encrypts
# per-user SMTP passwords at rest. On an EXISTING install, pin it to the current
# SECRET_KEY value before rotating SECRET_KEY, or saved SMTP passwords become
# undecryptable and users must re-enter them in Notification Settings.
NOTIFICATION_ENCRYPTION_KEY=

# SMTP (optional — per-user UI settings can override these defaults)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Web Push / VAPID (optional — generate keys with: vapid --gen  or  py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI Chat (DeepSeek) — get an API key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Admin bootstrap — JSON list of emails, e.g. ["you@example.com"]. Any EXISTING user (one who has
# already registered) whose email is in this list gets is_admin=True at the
# next startup. Does NOT create accounts. Once you have at least one admin,
# use the Admin page in the UI to issue invite codes for everyone else.
ADMIN_EMAILS=[]

# Absolute base URL used to build links in transactional emails (password
# reset, email verification), e.g. https://your-tailnet-name.ts.net. Falls
# back to the incoming request's own origin when unset.
PUBLIC_BASE_URL=

# Reverse-proxy trust for rate-limiting by client IP. Any reverse proxy —
# including Tailscale Funnel — makes request.client.host the PROXY's address,
# so with this false EVERY funnel visitor shares one per-IP rate-limit bucket
# and one person retrying a password can lock out everyone else.
#
# Tailscale Serve/Funnel connects from loopback and sets X-Forwarded-For to the
# real client IP, so SET THIS TO true WHEN USING FUNNEL. It is only safe if
# nothing can reach the app except tailscaled — bind the app to 127.0.0.1
# (docker compose maps 127.0.0.1:${BACKEND_PORT} by default). If the port is
# reachable directly, anyone can spoof X-Forwarded-For and bypass rate limits.
#
# Leave false only when clients connect to the app directly, with no proxy.
TRUST_PROXY_HEADERS=true

# Login / register / forgot-password rate limiting (in-process, per-IP and
# per-email sliding windows). Defaults are sane for a small friends/family
# deployment — tune only if you know you need to.
RATE_LIMIT_PER_IP_MAX=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=60
RATE_LIMIT_PER_EMAIL_MAX=5
RATE_LIMIT_PER_EMAIL_WINDOW_SECONDS=60
