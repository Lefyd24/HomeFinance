# Git
.git
.gitignore

# Python
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
**/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js
# NOTE: .dockerignore patterns are matched against the path relative to the
# context root, so a bare `node_modules/` would only exclude the one at the
# root — `**/` is what actually keeps frontend/app/node_modules (~650MB) out
# of the build context. The image installs deps itself in the react-builder
# stage; a host copy is both slow to transfer and wrong (host-native binaries).
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (we build in container)
frontend/app/dist

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database (will be created in container)
**/*.db
**/*.sqlite
**/*.sqlite3
data/

# Documentation
*.md
PLAN.md

# Testing
**/.pytest_cache/
.coverage
htmlcov/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Env files. Never bake these into the image — compose reads .env on the HOST
# and passes it in as real environment variables. A copy inside the image is
# both a secret leak and a config trap: a stale backend/.env used to override
# the real settings at runtime.
.env
**/.env
